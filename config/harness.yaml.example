engine:                 # `diploid:` is the YAML alias for this block
  provider: diploid       # `generic` or `fake`
  bin: ~/.local/bin/devin
  # start_args: ["acp", "--model", "swe-1-7"]  # override command-line args for other ACP binaries
  model: swe-1-7
  permission_mode: dangerous
  timeout: 900.0      # absolute prompt hard deadline; null waits for /stop or completion
  soft_timeout: 600.0 # seconds before auto-cancel + partial reply; null disables
  acp_watchdog_interval: 10.0 # seconds between transport health checks
  acp_watchdog_timeout: 120.0 # seconds without a control-call response before transport reset
  acp_resume_enabled: true  # use ACP session/resume (or load) instead of prompt rehydration
  continuation_triggers:  # plain-text replies that resume a partial turn
    - continue
    - go on
    - proceed
    - resume

persona:
  name: language-teacher
  profile_root: personas/language-teacher
  fleet_root: personas
  identity_class: worker
  memory_filename: MEMORY.md

harness:
  sessions_root: sessions
  session_store_path: sessions.jsonl
  dispatch_store_path: dispatch_store.jsonl  # optional; defaults next to session_store_path
  wake_store_path: wake_queue.jsonl           # optional; defaults next to session_store_path
  instance_ttl_seconds: 60.0
  listen_host: 127.0.0.1
  listen_port: 4003
  session_prune_enabled: true
  session_prune_days: 14
  waker:
    enabled: false
    interval_seconds: 5
    max_retries: 3
    retry_after: 30
    lease_seconds: 300
  timer:
    enabled: true
    interval_seconds: 5.0
    lease_seconds: 300.0
    max_retries: 5
    retry_after_seconds: 30.0
  plan:
    root: plans
    store_filename: plans.jsonl
  task:
    workers: 4
    shell_timeout: 60.0
    enabled_types:
      - shell
      - noop
      - acp
      - subagent
  plugin_paths:
    - ~/.devin/plugins
  plugins:
    - name: continuity
      enabled: true
      module: diploid_plugins.continuity
      prompt_slot: wake
      first_prompt_only: true
      prompt_order: 0
      state_file: chat_wake_state.json
      max_prompt_chars: 1024
    - name: identity
      enabled: true
      module: diploid_plugins.identity
      prompt_slot: self_narrative
      first_prompt_only: true
      prompt_order: 5
      state_file: chat_SELF.md
      max_prompt_chars: 2048
      skill: identity
      mcp_server:
        name: diploid-identity
        command: python
        args:
          - "-m"
          - "diploid_plugins.identity.identity_mcp"
          - "--chat-id"
          - "{chat_id}"
          - "--sessions-root"
          - "{sessions_root}"
        env: []
    - name: working_memory
      enabled: true
      module: diploid_plugins.working_memory
      prompt_slot: working_memory
      first_prompt_only: false
      prompt_order: 40
      state_file: chat_working_memory.json
      max_prompt_chars: 1024
      mcp_server:
        name: diploid-working-memory
        command: python
        args:
          - "-m"
          - "diploid_plugins.working_memory.working_memory_mcp"
          - "--chat-id"
          - "{chat_id}"
          - "--sessions-root"
          - "{sessions_root}"
        env: []
    - name: persistent_memory
      enabled: true  # auto-recalls on memory-seeking questions and auto-promotes ```memory blocks
      module: diploid_plugins.persistent_memory
      prompt_slot: persistent_memory
      first_prompt_only: false
      prompt_order: 32
      state_file: chat_persistent_memory.json
      max_prompt_chars: 1024
      config:
        auto_recall: true
        auto_promote: true
        auto_summarize_on_sleep: false
        check_short_term: true
        recall_max_tokens: 500
    - name: curriculum
      enabled: false  # example plugin; not needed for this persona
      module: diploid_plugins.curriculum
      prompt_slot: self_state
      first_prompt_only: false
      prompt_order: 100
      state_file: chat_curriculum.json
      max_prompt_chars: 1024
      mcp_server:
        name: diploid-curriculum
        command: python
        args:
          - "-m"
          - "diploid_plugins.curriculum.curriculum_mcp"
          - "--chat-id"
          - "{chat_id}"
          - "--sessions-root"
          - "{sessions_root}"
      skill: curriculum
    - name: planner
      enabled: true
      module: diploid_plugins.planner
      first_prompt_only: false
      prompt_order: 50
      max_prompt_chars: 1024
      config:
        trigger_prefix:
          - "!plan "
          - "Plan: "
        auto_triage: false
        model: null  # null uses the runtime default model
        max_tasks: 10
    - name: auto_continue
      enabled: true
      module: diploid_plugins.auto_continue
      first_prompt_only: false
      prompt_order: 55
      state_file: chat_auto_continue.json
      max_prompt_chars: 1024
      config:
        delay_seconds: 2.0
        max_attempts: 3
        stop_reasons:
          - timeout
          - cancelled
    - name: self_state
      enabled: true
      module: diploid_plugins.self_state
      prompt_slot: self_state
      prompt_order: 90
      state_file: chat_self_state.md
      max_prompt_chars: 512
    - name: self_management
      enabled: true
      module: diploid_plugins.self_management
      prompt_order: 95
      max_prompt_chars: 0
      mcp_server:
        name: diploid-self-management
        command: python
        args:
          - "-m"
          - "diploid_plugins.self_management.self_management_mcp"
          - "--chat-id"
          - "{chat_id}"
          - "--harness-url"
          - "{harness_url}"
          - "--sessions-root"
          - "{sessions_root}"
        env: []
  telegram:
    enabled: false
    webhook_port: 8080
    stream_thoughts: true
    stream_chunk_interval: 2.0
    intermediate_messages: true
    intermediate_idle: 3.0
    intermediate_min_chars: 20
    min_telegram_interval: 1.0
    min_edit_message_interval: 2.0
    message_format: markdown_v2
  notifications:
    enabled: true
    outbox_delivery: false     # set to true so the Telegram transport consumes the outbox instead of the runtime notifier
    webhook_url: null          # set to receive HTTP push on continuation
  memory:
    backend: file                  # file | hindsight
    n_turns_summarization: 100     # auto-summarize every N turns
    max_chat_memory_chars: 16384
    max_recall_chars: 8192         # extra client-side cap on recall results
    max_persona_memory_chars: 16384
    max_reply_quote_chars: 2048    # max chars of a Telegram reply-to quote to inject
    max_bot_reply_quote_chars: 240  # max chars to quote when replying to a bot message
    short_term_strategy: smart     # raw | smart
    short_term_turns: 10           # max raw turns to load
    min_short_term_turns: 2        # always keep this many raw turns
    max_short_term_chars: 6144     # cap the short-term block; older turns summarized
    include_short_term: true
    short_term_summary_cache_days: 7  # stale .cache/*.md entries are removed after this many days
    recall_on_follow_up: false     # run Hindsight recall on follow-ups; false skips it outside first/rehydrated turns
    hindsight:
      base_url: http://localhost:8888
      bank: example                 # defaults to persona name if unset
      api_key: null
      timeout: 120.0
      max_recall_tokens: 500
      recall_min_scores:
        semantic: 0.25
        reranker: 0.5
      prefer_observations: true
      async_writes: true
      fallback_to_file: true
  metrics:
    expose_in_prompt: false  # set to true to feed cumulative usage into the LLM prompt
    max_recent_turns: 100
  mcp:
    servers:
      - name: github
        command: npx
        args: ["-y", "@modelcontextprotocol/server-github"]
        env: []
      - name: diploid-memory
        command: python
        args:
          - "-m"
          - "diploid_agent.memory_mcp"
          - "--chat-id"
          - "{chat_id}"
          - "--harness-url"
          - "{harness_url}"
        env: []
      - name: diploid-curriculum
        command: python
        args:
          - "-m"
          - "diploid_plugins.curriculum.curriculum_mcp"
          - "--chat-id"
          - "{chat_id}"
          - "--sessions-root"
          - "{sessions_root}"
        env: []
      - name: diploid-harness
        command: python
        args:
          - "-m"
          - "diploid_plugins.harness.harness_mcp"
          - "--chat-id"
          - "{chat_id}"
          - "--harness-url"
          - "{harness_url}"
        env: []
    default_enabled: [github, diploid-memory, diploid-working-memory, diploid-identity, diploid-self-management, diploid-harness]
  skills:
    shared_root: personas/shared
    default_lazy: true  # only match skills by keyword; do not auto-load all default_enabled
    default_enabled:
      - review
      - model-review
      - memory
      - identity
    allow_chat_creation: true
