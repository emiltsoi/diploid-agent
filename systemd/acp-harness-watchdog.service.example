[Unit]
Description=ACP Fleet Harness Watchdog
After=acp-fleet-harness.service

[Service]
Type=simple
ExecStart=%h/CascadeProjects/acp-fleet-harness/.venv/bin/python %h/CascadeProjects/acp-fleet-harness/probes/acp_harness_watchdog.py --harness-url http://127.0.0.1:4003 --user
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
