#!/usr/bin/env python3
"""CLI probe for the harness plan/task endpoints."""

from __future__ import annotations

import argparse
import json
import sys
from urllib.parse import urljoin

import httpx


def _make_url(base: str, path: str) -> str:
    return urljoin(base.rstrip("/") + "/", path)


def _load_task(raw: str) -> dict[str, str]:
    try:
        return json.loads(raw)
    except json.JSONDecodeError as exc:
        raise argparse.ArgumentTypeError(f"Invalid task JSON: {exc}") from exc


def main() -> int:
    parser = argparse.ArgumentParser(description="Drive the harness plan API.")
    parser.add_argument("--harness-url", default="http://127.0.0.1:4003")
    parser.add_argument("--api-key")
    sub = parser.add_subparsers(dest="command", required=True)

    create = sub.add_parser("create")
    create.add_argument("name")
    create.add_argument("--description", default="")
    create.add_argument("--chat-id")
    create.add_argument(
        "--task",
        dest="tasks",
        action="append",
        type=_load_task,
        default=[],
        help='JSON task object, e.g. \'{"name":"test","command":"pytest -q"}\'',
    )

    start = sub.add_parser("start")
    start.add_argument("plan_id")
    start.add_argument("--task-id")

    done = sub.add_parser("done")
    done.add_argument("plan_id")
    done.add_argument("task_id")
    done.add_argument("--result", default="")
    done.add_argument("--log", default="")

    sub.add_parser("list")

    status = sub.add_parser("status")
    status.add_argument("plan_id")

    args = parser.parse_args()
    headers = {"X-API-Key": args.api_key} if args.api_key else {}
    base = args.harness_url.rstrip("/") + "/"

    try:
        if args.command == "create":
            payload = {
                "name": args.name,
                "description": args.description,
                "chat_id": args.chat_id,
                "tasks": args.tasks,
            }
            resp = httpx.post(
                _make_url(base, "plan/create"),
                json=payload,
                headers=headers,
                timeout=30.0,
            )
        elif args.command == "start":
            resp = httpx.post(
                _make_url(base, "plan/task/start"),
                json={"plan_id": args.plan_id, "task_id": args.task_id},
                headers=headers,
                timeout=30.0,
            )
        elif args.command == "done":
            resp = httpx.post(
                _make_url(base, "plan/task/done"),
                json={
                    "plan_id": args.plan_id,
                    "task_id": args.task_id,
                    "result": args.result,
                    "log": args.log,
                },
                headers=headers,
                timeout=30.0,
            )
        elif args.command == "list":
            resp = httpx.get(
                _make_url(base, "plan/list"),
                headers=headers,
                timeout=30.0,
            )
        elif args.command == "status":
            resp = httpx.get(
                _make_url(base, f"plan/{args.plan_id}"),
                headers=headers,
                timeout=30.0,
            )
        else:
            return 1
    except httpx.RequestError as exc:
        print(f"request failed: {exc}", file=sys.stderr)
        return 1

    if resp.status_code != 200:
        print(f"HTTP {resp.status_code}: {resp.text}", file=sys.stderr)
        return 1

    print(json.dumps(resp.json(), indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
